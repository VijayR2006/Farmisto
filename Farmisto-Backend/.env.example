PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/farmisto
# Generate a unique, random secret of at least 32 characters for each environment.
JWT_SECRET=replace-with-a-random-secret

# Cloudinary uploads remain enabled when these are set.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_MAP_KEY=
MAX_FILE_SIZE=5242880

# Optional demo-seed credentials. Use a different random value for each.
DEMO_FARMER_ONE_PASSWORD=
DEMO_FARMER_TWO_PASSWORD=
DEMO_FARMER_THREE_PASSWORD=
